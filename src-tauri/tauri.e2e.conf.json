{
  "build": {
    "beforeBuildCommand": "pnpm build --mode e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e-automation",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
