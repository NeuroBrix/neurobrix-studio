{
  "name": "neurobrix-studio",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p test/e2e/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "pnpm tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json -- --target-dir target/e2e && wdio run test/e2e/wdio.conf.ts",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "1.44.0",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.13.4",
    "@vitest/browser-playwright": "5.0.0",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "@wdio/types": "^9.31.2",
    "clsx": "^2.1.1",
    "mocha": "^11.8.0",
    "playwright": "1.63.0",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "vitest-browser-svelte": "3.1.0",
    "webdriverio": "^9.31.7"
  }
}
